# --- アプリ ---
APP_ENV=development
# フロントのURL（マジックリンクの遷移先に使用）
FRONTEND_URL=http://localhost:5173
# CORS で許可するフロントのオリジン (カンマ区切り)
CORS_ORIGINS=http://localhost:5173

# --- DB (PostgreSQL / async) ---
DATABASE_URL=postgresql+asyncpg://fortune:fortune@localhost:5432/fortune

# --- 認証 ---
# JWT 署名鍵（本番では十分に長いランダム値に置き換える）
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# マジックリンクの有効時間（分）
MAGIC_LINK_EXPIRE_MINUTES=15
# ログインセッション(JWT)の有効時間（分）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- メール送信 ---
# console | smtp （現状は console のみ実装）
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@fortune.local

# --- ファイルストレージ（アイコン等） ---
# local | s3 （現状は local のみ実装）
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
